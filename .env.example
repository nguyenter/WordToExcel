# Flask Configuration
SECRET_KEY=your-secret-key-here
MAX_UPLOAD_MB=8
# Render: https://your-app-name.onrender.com
# PythonAnywhere: https://<username>.pythonanywhere.com
PUBLIC_BASE_URL=https://your-username.pythonanywhere.com
FILE_TTL_MINUTES=15
DOWNLOAD_TOKEN_TTL_MINUTES=3

# API Key Configuration (để bypass payment)
API_KEY=your-api-key-here

# Supabase Configuration
SUPABASE_URL=your-supabase-url-here
SUPABASE_KEY=your-supabase-key-here

# PayOS Configuration (lấy từ my.payos.vn → Kênh thanh toán → Client ID / API Key / Checksum Key)
# Không thêm dấu ngoặc kép, không có khoảng trắng thừa ở đầu/cuối.
PAYOS_CLIENT_ID=your-payos-client-id-here
PAYOS_API_KEY=your-payos-api-key-here
PAYOS_CHECKSUM_KEY=your-payos-checksum-key-here
